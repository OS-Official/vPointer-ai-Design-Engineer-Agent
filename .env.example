# Copy to .env and fill in. Never commit .env.

# ---- Which model runs the agent ----
# anthropic (Claude, needs ANTHROPIC_API_KEY) or ollama (your local model, free, nothing leaves your computer).
# "dea --local" uses Ollama for one session whatever this says.
DEA_PROVIDER=anthropic

# ---- Anthropic (Claude) ----
# Get a key at https://console.anthropic.com (not needed for --local)
ANTHROPIC_API_KEY=
# Lead model: opus, sonnet (cheaper) or haiku (cheapest)
DEA_MODEL=opus
# Spending cap per session in USD
DEA_MAX_BUDGET_USD=5

# ---- Local model (Ollama) ----
DEA_OLLAMA_URL=http://localhost:11434
# Exact name from `ollama list`
DEA_OLLAMA_MODEL=qwen3-coder-32k:latest
# Longest reply per step, in tokens. Keep it small on a 32k context.
DEA_OLLAMA_MAX_OUTPUT=4096

# ---- Other APIs (providers.json) ----
# A provider of type "anthropic-compatible" reads its key from the variable named in its apiKeyEnv, e.g.
# DEA_PROVIDER_OTHER_API_KEY=

# ---- The window (npm run ui) ----
# DEA_UI_PORT=4317
# New chats in a folder start with short notes from earlier chats there (logs/ui/memory/, on this computer only).
# To turn that off:
# DEA_MEMORY=off

# ---- Apps (MCP) ----
# Apps such as Figma, Playwright, GitHub and Supabase are set up in mcp.json, not here.
# Figma's desktop server and Playwright need no key. Fill these only for the apps you turn on:
# DEA_MCP_GITHUB_TOKEN=
# DEA_MCP_SUPABASE_TOKEN=
# DEA_MCP_SUPABASE_PROJECT_REF=
# Secrets they need go here and are referenced in mcp.json as ${NAME}
# (npm run mcp:import adds them for you, named DEA_MCP_<APP>_<KEY>).
